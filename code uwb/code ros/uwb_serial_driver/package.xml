<?xml version="1.0"?>
<package format="3">
  <name>uwb_serial_driver</name>
  <version>0.1.0</version>
  <description>Read UWB ranging data from an ESP32 serial port and publish ROS 2 topics.</description>
  <maintainer email="maintainer@example.com">UGV team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nlohmann_json</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
